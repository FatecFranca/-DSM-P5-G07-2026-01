

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// USUÁRIOS
// ─────────────────────────────────────────

model User {
  id             String   @id @default(uuid())
  name           String   @db.VarChar(50)
  email          String   @unique @db.VarChar(100)
  birthDate      DateTime @map("birth_date") @db.Date
  passwordHash   String   @map("password_hash")
  onboardingDone Boolean  @default(false) @map("onboarding_done")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  onboardingProfile OnboardingProfile?
  genres            UserGenre[]
  playlists         Playlist[]

  @@map("users")
}

// ─────────────────────────────────────────
// PASSWORD RESET TOKEN
// ─────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String    @db.VarChar(100)
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────
// ONBOARDING
// ─────────────────────────────────────────

model OnboardingProfile {
  id               String          @id @default(uuid())
  userId           String          @unique @map("user_id")
  audioPreference  AudioPreference @map("audio_preference")
  danceability     Float           @default(0)
  energy           Float           @default(0)
  valence          Float           @default(0)
  acousticness     Float           @default(0)
  instrumentalness Float           @default(0)
  speechiness      Float           @default(0)
  tempo            Float           @default(0)
  updatedAt        DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding_profiles")
}

enum AudioPreference {
  INSTRUMENTAL
  VOCAL
  MIXED

  @@map("audio_preference")
}

// ─────────────────────────────────────────
// GÊNEROS
// ─────────────────────────────────────────

model Genre {
  id         String @id @default(uuid())
  name       String @db.VarChar(100)
  spotifyKey String @unique @map("spotify_key") @db.VarChar(50)

  userGenres UserGenre[]
  tracks     TrackGenre[]

  @@map("genres")
}

model UserGenre {
  id      String @id @default(uuid())
  userId  String @map("user_id")
  genreId String @map("genre_id")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@unique([userId, genreId])
  @@map("user_genres")
}

// ─────────────────────────────────────────
// TRACKS
// ─────────────────────────────────────────

model Track {
  id               String  @id @default(uuid())
  spotifyId        String  @unique @map("spotify_id") @db.VarChar(50)
  trackName        String  @map("track_name") @db.VarChar(255)
  artists          String  @db.Text
  albumName        String  @map("album_name") @db.VarChar(255)
  popularity       Int
  durationMs       Int     @map("duration_ms")
  explicit         Boolean @default(false)

  vibe             Vibe
  energy           Float
  valence          Float
  danceability     Float
  acousticness     Float
  instrumentalness Float
  speechiness      Float
  liveness         Float
  loudness         Float
  tempo            Float
  key              Int
  mode             Int
  timeSignature    Int     @map("time_signature")

  createdAt DateTime @default(now()) @map("created_at")

  genres         TrackGenre[]
  playlistTracks PlaylistTrack[]

  @@index([vibe])
  @@map("tracks")
}

model TrackGenre {
  trackId String @map("track_id")
  genreId String @map("genre_id")

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([trackId, genreId])
  @@map("track_genres")
}

// ─────────────────────────────────────────
// PLAYLISTS
// ─────────────────────────────────────────

model Playlist {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  name        String       @db.VarChar(100)
  objective   Objective
  energyLevel EnergyLevel  @map("energy_level")
  mood        Mood
  type        PlaylistType
  generatedAt DateTime     @default(now()) @map("generated_at")

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks PlaylistTrack[]

  @@map("playlists")
}

model PlaylistTrack {
  id         String @id @default(uuid())
  playlistId String @map("playlist_id")
  trackId    String @map("track_id")
  position   Int

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, position])
  @@map("playlist_tracks")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Objective {
  FOCUS
  WORKOUT
  RELAX
  MOOD_BOOST

  @@map("objective")
}

enum EnergyLevel {
  LOW
  MEDIUM
  HIGH

  @@map("energy_level")
}

enum Mood {
  HAPPY
  NEUTRAL
  ANXIOUS
  SAD

  @@map("mood")
}

enum PlaylistType {
  AUTOMATIC
  ON_DEMAND

  @@map("playlist_type")
}

enum Vibe {
  FOCUS
  WORKOUT
  PARTY
  RELAX
  CHILL
  ROMANTIC

  @@map("vibe")
}

