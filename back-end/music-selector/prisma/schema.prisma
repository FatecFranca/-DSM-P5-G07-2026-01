

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// USUÁRIOS
// ─────────────────────────────────────────

model User {
  id             String   @id @default(uuid())
  name           String   @db.VarChar(50)
  email          String   @unique @db.VarChar(100)
  birthDate      DateTime @map("birth_date") @db.Date
  passwordHash   String   @map("password_hash")
  onboardingDone Boolean  @default(false) @map("onboarding_done")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  playlists Playlist[]

  @@map("users")
}

// ─────────────────────────────────────────
// PASSWORD RESET TOKEN
// ─────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String    @db.VarChar(100)
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}




model Track {
  id               String  @id @default(uuid())
  spotifyId        String  @unique @map("spotify_id") @db.VarChar(50)
  trackName        String  @map("track_name") @db.VarChar(255)
  artists          String  @db.Text
  albumName        String  @map("album_name") @db.VarChar(255)
  popularity       Int
  durationMs       Int     @map("duration_ms")
  explicit         Boolean @default(false)

  vibe             Vibe
  energy           Float
  valence          Float
  danceability     Float
  acousticness     Float
  instrumentalness Float
  speechiness      Float
  liveness         Float
  loudness         Float
  tempo            Float
  key              Int
  mode             Int
  timeSignature    Int     @map("time_signature")

  createdAt DateTime @default(now()) @map("created_at")

  playlistTracks PlaylistTrack[]

  @@index([vibe])
  @@map("tracks")
}


// ─────────────────────────────────────────
// PLAYLISTS
// ─────────────────────────────────────────

model Playlist {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  name        String       @db.VarChar(100)
  objective   Objective
  energyLevel EnergyLevel  @map("energy_level")
  mood        Mood
  type        PlaylistType
  generatedAt DateTime     @default(now()) @map("generated_at")

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks PlaylistTrack[]

  @@map("playlists")
}

model PlaylistTrack {
  id         String @id @default(uuid())
  playlistId String @map("playlist_id")
  trackId    String @map("track_id")
  position   Int

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, position])
  @@map("playlist_tracks")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Objective {
  FOCUS
  WORKOUT
  RELAX
  MOOD_BOOST

  @@map("objective")
}

enum EnergyLevel {
  LOW
  MEDIUM
  HIGH

  @@map("energy_level")
}

enum Mood {
  HAPPY
  NEUTRAL
  ANXIOUS
  SAD

  @@map("mood")
}

enum PlaylistType {
  AUTOMATIC
  ON_DEMAND

  @@map("playlist_type")
}

enum Vibe {
  FOCUS
  WORKOUT
  PARTY
  RELAX
  CHILL
  ROMANTIC

  @@map("vibe")
}

